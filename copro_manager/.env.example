# Clé secrète pour sécuriser les sessions. À remplacer par une valeur unique
# (ex: 40 caractères aléatoires). NE JAMAIS la partager ni la committer.
SECRET_KEY=change-moi-par-une-cle-secrete-longue-et-aleatoire

# Adresse et port d'écoute du serveur.
# 0.0.0.0 = accessible depuis les autres postes du réseau.
# Mettre 127.0.0.1 pour restreindre au poste local uniquement.
COPRO_HOST=0.0.0.0
COPRO_PORT=5000
# Mot de passe de l'application (optionnel mais recommandé dès que l'appli
# est exposée sur le réseau ou Internet). Générer le hash avec :
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('TON_MOT_DE_PASSE'))"
# Sans cette variable, l'application est accessible sans mot de passe.
APP_PASSWORD_HASH=
